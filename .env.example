# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs with admin rights (/allow, /invite)
ADMIN_IDS=

# Path to the SQLite database file
DB_PATH=data/chain_health.db

# Daily reminder time (HH:MM) and timezone
REMINDER_TIME=19:00
TZ=Europe/Moscow

# Proxy for api.telegram.org. Needed where the ISP blocks Telegram;
# leave empty to connect directly.
TELEGRAM_PROXY=
